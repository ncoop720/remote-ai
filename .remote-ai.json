{
  "setup": ["npm ci"],
  "servers": [
    {
      "name": "api",
      "command": "REMOTE_AI_PORT=$PORT REMOTE_AI_DATA_DIR=~/.remote-ai-dev/$PORT REMOTE_AI_WORKTREES_DIR=~/.remote-ai-dev/$PORT/worktrees npm run dev:server"
    },
    {
      "name": "web",
      "command": "REMOTE_AI_PORT=$PORT_API npx vite --port $PORT --strictPort"
    }
  ]
}
