{
  "name": "remote-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted web dashboard for Claude Code sessions: one tmux session per git worktree, usable from desktop or phone.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit && tsc -p desktop --noEmit",
    "test": "node --import tsx --test \"server/src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"desktop/**/*.test.ts\"",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/build-desktop.mjs && electron dist/desktop",
    "desktop:dist": "node scripts/build-desktop.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^5.12.5",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
